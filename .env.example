# =====================================================
# LangChain AI 聊天助手 —— 环境变量模板
# 用法：复制本文件为 .env 后按需修改（.env 不会提交到 Git）
#   Windows:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# =====================================================

# 模型提供商：openai（任意 OpenAI 兼容服务）/ ollama（本地）/ fake（离线演示）
LLM_PROVIDER=openai

# ---------- OpenAI 兼容接口（provider=openai 时生效）----------
# 示例（OpenAI 官方）：
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# 示例（DeepSeek）：
# OPENAI_API_KEY=sk-你的DeepSeekKey
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 示例（Moonshot / Kimi）：
# OPENAI_API_KEY=sk-你的MoonshotKey
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-8k

# ---------- Ollama 本地模型（provider=ollama 时生效）----------
# 需先启动: ollama serve && ollama pull qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---------- 生成参数 ----------
# TEMPERATURE=0.7
# MAX_TOKENS=2048

# ---------- 记忆 ----------
# MAX_HISTORY_MESSAGES=20
# 记忆持久化：指定 SQLite 文件路径后，会话历史重启不丢；删除此行或留空 = 纯内存
# MEMORY_DB_PATH=chat_history.db

# ---------- 会话 ----------
# SESSION_ID=default

# ---------- 系统提示词 ----------
# SYSTEM_PROMPT=你是一个乐于助人、知识渊博的 AI 助手。请用简洁、准确、友好的中文回答用户的问题。


# =====================================================
# RAG 知识库（python -m rag.main）—— 环境变量
# 未填写的项会自动回退到上面的 OPENAI_* 配置
# =====================================================

# ---------- 嵌入模型（Embedding）----------
# 留空则复用上面的 OPENAI_API_KEY / OPENAI_BASE_URL
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EMBEDDING_MODEL=ep-20260420014217-l6bqr
# EMBEDDING_DIMENSION=2048
# EMBEDDING_CACHE_ENABLED=true
# EMBEDDING_CACHE_TTL=86400

# ---------- Redis 嵌入向量缓存（可选，不可用则自动降级为不缓存）----------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ---------- Milvus 向量数据库 ----------
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_TOKEN=
# MILVUS_COLLECTION_NAME=rag_documents

# ---------- 文档分块 ----------
# CHUNK_MIN_SIZE=200
# CHUNK_MAX_SIZE=800
# CHUNK_TARGET_SIZE=500
# CHUNK_OVERLAP=100

# ---------- 检索 ----------
# RETRIEVAL_TOP_K=3
# RERANK_ENABLED=true
# RERANK_TOP_K=5
# RERANK_FINAL_TOP_K=3
# RERANK_METHOD=keyword
# BM25_ENABLED=false
# BM25_WEIGHT=0.3
# BM25_TOP_K=5

# ---------- 失败重试（指数退避）----------
# RETRY_ENABLED=true
# RETRY_MAX_ATTEMPTS=3
# RETRY_INITIAL_DELAY=1000
# RETRY_MAX_DELAY=10000
# RETRY_MULTIPLIER=2.0
