                </mxCell>
                <mxCell id="lane3" value="③ 总控协调官 Supervisor（只调度决策，不碰数据）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#EAF2FA;strokeColor=#B7C4D1;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
